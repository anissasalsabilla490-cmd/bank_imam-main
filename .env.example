APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- Penarikan saldo digital (Xendit Payouts) ---
WITHDRAWAL_ENABLED=true
WITHDRAWAL_MIN=10000
WITHDRAWAL_MAX=500000
WITHDRAWAL_DAILY_AMOUNT=1000000
WITHDRAWAL_DAILY_COUNT=3
WITHDRAWAL_FEE_EWALLET=0
WITHDRAWAL_FEE_BANK=0
XENDIT_BASE_URL=https://api.xendit.co
# Sandbox: xnd_development_... | Produksi: xnd_production_... (JANGAN pernah di-commit ke git)
XENDIT_SECRET_KEY=
# Dari Dashboard Xendit > Settings > Developers > Callbacks
XENDIT_CALLBACK_TOKEN=
