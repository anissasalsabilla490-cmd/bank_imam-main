APP_NAME=BankImam
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=bank_imam
DB_USERNAME=root
DB_PASSWORD=root

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

# --- Penarikan saldo digital (Xendit Payouts) ---
WITHDRAWAL_ENABLED=true
WITHDRAWAL_MIN=10000
WITHDRAWAL_MAX=500000
WITHDRAWAL_DAILY_AMOUNT=1000000
WITHDRAWAL_DAILY_COUNT=3
WITHDRAWAL_FEE_EWALLET=0
WITHDRAWAL_FEE_BANK=0
XENDIT_BASE_URL=https://api.xendit.co
# Sandbox: xnd_development_... | Produksi: xnd_production_... (JANGAN pernah di-commit ke git)
XENDIT_SECRET_KEY=
# Dari Dashboard Xendit > Settings > Developers > Callbacks
XENDIT_CALLBACK_TOKEN=
