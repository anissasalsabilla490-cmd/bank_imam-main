BROADCAST_DRIVER=log
CACHE_DRIVER=file
# database = antrian penarikan saldo diproses lewat scheduler/worker
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

# --- Penarikan saldo (Xendit). Kosongkan dulu saat lokal ---
WITHDRAWAL_ENABLED=false
WITHDRAWAL_MIN=10000
