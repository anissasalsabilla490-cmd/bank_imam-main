APP_NAME=BankImam
APP_ENV=local
APP_KEY=base64:NminS0eLP7+rp0cOVkY1f9kpsIOXKugZ5NzjCgetVVQ=
APP_DEBUG=true
# Laragon otomatis membuat http://NAMA-FOLDER.test  (folder: bank_imam-main)
